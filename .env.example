# Server-side only. Never expose these to the browser.
YOUCAM_API_KEY=
GEMINI_API_KEY=

# Optional overrides
PROOFPICK_MODEL=gemini-3.6-flash
PROOFPICK_MAX_PREVIEWS_PER_SESSION=3
PROOFPICK_MAX_RETRIES_PER_SESSION=1
# Whole-deployment cap on YouCam tasks per UTC day; 0 turns it off. Set after checking the V4 unit cost in your account.
PROOFPICK_MAX_TASKS_PER_DAY=30
PROOFPICK_POLL_INTERVAL_SECONDS=10

# Lets the team add photographed garments from the Catalog page. Set to false on a public deployment.
PROOFPICK_ALLOW_CATALOG_EDITS=true
